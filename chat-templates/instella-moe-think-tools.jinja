{#- instella-moe-think-tools: AMD Instella-MoE template restructured for tool use.

    The DeepSeek tool tokens in this vocab (128806-128814) appear in zero training
    examples, so this template avoids them entirely:
    - tool schemas are injected into the system prompt (AMD's template discards `tools`)
    - tool calls render as Hermes/Qwen-style plain text <tool_call> JSON blocks, which
      llama.cpp's differential autoparser detects without C++ changes
    - tool results render as <tool_response> blocks inside a <｜User｜> turn instead of
      the untrained <｜tool▁outputs▁begin｜> tokens

    Kept from instella-moe-think.jinja: pre-opened <think>\n in the generation prompt
    and stripping </think>-terminated reasoning from assistant history.
-#}
{%- if not add_generation_prompt is defined %}{% set add_generation_prompt = false %}{% endif %}
{%- set ns = namespace(in_tool_group=false, system_prompt='', is_first_sp=true) %}
{%- for message in messages %}
    {%- if message['role'] == 'system' %}
        {%- if ns.is_first_sp %}
            {%- set ns.system_prompt = ns.system_prompt + message['content'] %}
            {%- set ns.is_first_sp = false %}
        {%- else %}
            {%- set ns.system_prompt = ns.system_prompt + '\n\n' + message['content'] %}
        {%- endif %}
    {%- endif %}
{%- endfor %}
{%- if tools %}
    {%- set ns.system_prompt = ns.system_prompt + '\n\n# Tools\n\nYou may call one or more functions to assist with the user query.\n\nYou are provided with function signatures within <tools></tools> XML tags:\n<tools>' %}
    {%- for tool in tools %}
        {%- set ns.system_prompt = ns.system_prompt + '\n' + (tool | tojson) %}
    {%- endfor %}
    {%- set ns.system_prompt = ns.system_prompt + '\n</tools>\n\nFor each function call, return a json object with function name and arguments within <tool_call></tool_call> XML tags:\n<tool_call>\n{"name": <function-name>, "arguments": <args-json-object>}\n</tool_call>' %}
{%- endif %}
{{- bos_token }}{{ ns.system_prompt }}
{%- for message in messages %}
    {%- if message['role'] == 'user' %}
        {%- set ns.in_tool_group = false %}
        {{- '<｜User｜>' + message['content'] }}
    {%- elif message['role'] == 'assistant' %}
        {%- set ns.in_tool_group = false %}
        {%- set content = message['content'] if message['content'] is not none else '' %}
        {%- if '</think>' in content %}
            {%- set content = content.split('</think>')[-1] %}
        {%- endif %}
        {#- Render reasoning_content when a client supplies it. This also lets the
            autoparser's differential probe discover the <think> markers, which is
            what arms --reasoning-budget for this template. -#}
        {%- if message['reasoning_content'] %}
            {{- '<｜Assistant｜><think>\n' + message['reasoning_content'] + '\n</think>\n' + content }}
        {%- else %}
            {{- '<｜Assistant｜>' + content }}
        {%- endif %}
        {%- if message['tool_calls'] %}
            {%- for tool_call in message['tool_calls'] %}
                {%- set fn = tool_call['function'] %}
                {{- '\n<tool_call>\n{"name": "' + fn['name'] + '", "arguments": ' }}
                {%- if fn['arguments'] is string %}
                    {{- fn['arguments'] }}
                {%- else %}
                    {{- fn['arguments'] | tojson }}
                {%- endif %}
                {{- '}\n</tool_call>' }}
            {%- endfor %}
        {%- endif %}
        {{- '<｜end▁of▁sentence｜>' }}
    {%- elif message['role'] == 'tool' %}
        {%- if not ns.in_tool_group %}
            {{- '<｜User｜>' }}
            {%- set ns.in_tool_group = true %}
        {%- else %}
            {{- '\n' }}
        {%- endif %}
        {{- '<tool_response>\n' + message['content'] + '\n</tool_response>' }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {%- if enable_thinking is defined and not enable_thinking %}
        {{- '<｜Assistant｜><think>\n\n</think>\n\n' }}
    {%- else %}
        {{- '<｜Assistant｜><think>\n' }}
    {%- endif %}
{%- endif %}
